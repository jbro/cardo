#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    /* The PCB has two electrically independent shift-register chains.
     * They share SPI data/clock, but have separate latch (CS) lines.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        /* U1-U2 (ROW1_CS), then U3/U5-U6 (ROW2_CS). */
        col-gpios =
            <&shifter_row1 0 GPIO_ACTIVE_HIGH>, <&shifter_row1 1 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 2 GPIO_ACTIVE_HIGH>, <&shifter_row1 3 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 4 GPIO_ACTIVE_HIGH>, <&shifter_row1 5 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 6 GPIO_ACTIVE_HIGH>, <&shifter_row1 7 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 8 GPIO_ACTIVE_HIGH>, <&shifter_row1 9 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 10 GPIO_ACTIVE_HIGH>, <&shifter_row1 11 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 12 GPIO_ACTIVE_HIGH>, <&shifter_row1 13 GPIO_ACTIVE_HIGH>,
            <&shifter_row1 14 GPIO_ACTIVE_HIGH>, <&shifter_row1 15 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 0 GPIO_ACTIVE_HIGH>, <&shifter_row2 1 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 2 GPIO_ACTIVE_HIGH>, <&shifter_row2 3 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 4 GPIO_ACTIVE_HIGH>, <&shifter_row2 5 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 6 GPIO_ACTIVE_HIGH>, <&shifter_row2 7 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 8 GPIO_ACTIVE_HIGH>, <&shifter_row2 9 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 10 GPIO_ACTIVE_HIGH>, <&shifter_row2 11 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 12 GPIO_ACTIVE_HIGH>, <&shifter_row2 13 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 14 GPIO_ACTIVE_HIGH>, <&shifter_row2 15 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 16 GPIO_ACTIVE_HIGH>, <&shifter_row2 17 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 18 GPIO_ACTIVE_HIGH>, <&shifter_row2 19 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 20 GPIO_ACTIVE_HIGH>, <&shifter_row2 21 GPIO_ACTIVE_HIGH>,
            <&shifter_row2 22 GPIO_ACTIVE_HIGH>, <&shifter_row2 23 GPIO_ACTIVE_HIGH>;

        /* XIAO D0/D2: ROW1 and ROW2 switch inputs. */
        row-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <40>;
        rows = <2>;
        /* The first 16 matrix columns are on ROW1_A; the remaining 21
         * populated columns are on ROW2_A (shift-register pins 0-20).
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
            RC(1,16) RC(1,17) RC(1,18) RC(1,19) RC(1,20) RC(1,21) RC(1,22) RC(1,23)
            RC(1,24) RC(1,25) RC(1,26) RC(1,27) RC(1,28) RC(1,29) RC(1,30) RC(1,31)
            RC(1,32) RC(1,33) RC(1,34) RC(1,35) RC(1,36)
        >;
    };

    encoder1: encoder1 {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <48>;
        status = "okay";
    };

    encoder2: encoder2 {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <48>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder1 &encoder2>;
        triggers-per-rotation = <12>;
    };
};

&spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    /* XIAO D1/D3: ROW1_CS and ROW2_CS. */
    cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>, <&gpio0 29 GPIO_ACTIVE_LOW>;

    shifter_row1: gpio595_row1@0 {
        compatible = "zmk,gpio-595";
        reg = <0>;
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        spi-max-frequency = <1000000>;
    };

    shifter_row2: gpio595_row2@1 {
        compatible = "zmk,gpio-595";
        reg = <1>;
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <24>;
        spi-max-frequency = <1000000>;
    };
};
